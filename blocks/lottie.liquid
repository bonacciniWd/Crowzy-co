{% assign lottie_block_class = 'lottie-block__media lottie-block-' | append: block.id %}

{% capture lottie_code %}
  <div
    class="{{ lottie_block_class }}"
    style="width: {{ block.settings.width }}px;"
    data-lottie
    data-src="{{ 'vrz.json' | asset_url }}"
    data-loop="true"
    data-autoplay="true"
  ></div>
{% endcapture %}

{%- if block.settings.link != blank -%}
  <a
    href="{{ block.settings.link }}"
    class="text-inherit"
    {% if block.settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ lottie_code }}
  </a>
{%- else -%}
  {{ lottie_code }}
{%- endif %}

{% stylesheet %}
  .lottie-block {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lottie-block__media {
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bloco Lottie",
  "settings": [
    {
      "type": "range",
      "id": "width",
      "label": "Largura da animação",
      "min": 50,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (opcional)"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Abrir em nova aba?",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Bloco com animação Lottie",
      "category": "Animações"
    }
  ]
}
{% endschema %}
